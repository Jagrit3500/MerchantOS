# ==========================================
# MerchantOS Environment Configuration
# Copy this file to .env and configure keys
# ==========================================

# Groq API Key (Primary LLM Engine)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Optional Gemini API Key (Alternative Backend)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Inference Parameters
MAX_TOKENS=1024
TEMPERATURE=0.0

# Embedding & Vector Database Configuration
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=50
CHUNK_SIZE=900
CHUNK_OVERLAP=150
CHROMA_DB_PATH=chroma_db
COLLECTION_NAME=pdf_chunks

# Retrieval Precision & Thresholds
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.55

# Server Ports
PORT_HOME=8501
PORT_AGENT1=8502
PORT_AGENT2=8503
PORT_AGENT3=8504
MERCHANTOS_HOST=localhost
