# ==========================================
# MerchantOS Environment Configuration
# Copy this file to .env and configure keys
# ==========================================

# Authentication
AUTH_ENABLED=1
AUTH_ALLOW_REGISTRATION=1
AUTH_DB_PATH=runtime/merchantos_auth.sqlite3
AUTH_COOKIE_NAME=merchantos_session
AUTH_SESSION_HOURS=168
AUTH_PBKDF2_ITERATIONS=310000
AUTH_MIN_PASSWORD_LENGTH=10
AUTH_MAX_PASSWORD_LENGTH=256
AUTH_MAX_EMAIL_LENGTH=254
AUTH_MAX_NAME_LENGTH=80
AUTH_MAX_TOKEN_LENGTH=128
AUTH_DB_TIMEOUT_SECONDS=5
AUTH_SQLITE_BUSY_TIMEOUT_MS=5000
AUTH_PASSWORD_SALT_BYTES=16
AUTH_SESSION_TOKEN_BYTES=32
AUTH_MAX_REQUEST_BYTES=16384
AUTH_RATE_LIMIT_ATTEMPTS=8
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# Set to 1 behind HTTPS in production.
AUTH_SECURE_COOKIE=0
# Optional comma-separated allowlist, for example: example.com,company.in
AUTH_ALLOWED_EMAIL_DOMAINS=

# Google sign-in (create a Web application OAuth client in Google Cloud)
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI.
GOOGLE_AUTH_ENABLED=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4173/api/auth/google/callback
GOOGLE_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_SCOPES=openid email profile
GOOGLE_OAUTH_STATE_MINUTES=10
GOOGLE_OAUTH_TIMEOUT_SECONDS=10
GOOGLE_OAUTH_COOKIE_NAME=merchantos_oauth_state

# Groq API Key (Primary LLM Engine)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# LLM Inference Parameters
MAX_TOKENS=1024
TEMPERATURE=0.0
LLM_TIMEOUT=10.0
LLM_FALLBACK_CHUNKS=3
LLM_FALLBACK_CHARS=500
# Automatically run semantic retrieval after a workflow produces a result.
# The fast local matcher remains the fallback if the model/index is unavailable.
AUTO_FETCH_POLICY_EVIDENCE=1
POLICY_EVIDENCE_RESULTS=3
POLICY_EVIDENCE_EXCERPT_CHARS=650
POLICY_EVIDENCE_MIN_CHARS=45
POLICY_EVIDENCE_HEADING_MAX_CHARS=120
POLICY_EVIDENCE_TERM_FREQUENCY_CAP=3

# Embedding & Vector Database Configuration
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
# Optional shared Hugging Face cache; EMBEDDING_CACHE_DIR takes precedence.
# HF_HUB_CACHE=C:/path/to/huggingface/hub
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=50
CHUNK_SIZE=900
CHUNK_OVERLAP=150
CHROMA_DB_PATH=chroma_db
COLLECTION_NAME=pdf_chunks
# Optional override; otherwise EMBEDDING_CACHE_DIR uses HF_HUB_CACHE or the local default.
# EMBEDDING_CACHE_DIR=C:/path/to/huggingface/hub
DOCS_DIR=docs
UPLOAD_DIR=uploads
SAMPLE_SETTLEMENT_PATH=Agent2/sample_data/sample_settlement.csv
SHARED_STATE_PATH=runtime/latest_reconciliation.json
ACTIVITY_DB_PATH=runtime/merchantos_activity.sqlite3
ACTIVITY_HISTORY_DISPLAY_LIMIT=50
ACTIVITY_HISTORY_QUERY_LIMIT=500
ACTIVITY_TITLE_MAX_LENGTH=160
ACTIVITY_DETAIL_MAX_LENGTH=800
ACTIVITY_ACTION_MAX_LENGTH=80
ACTIVITY_HEATMAP_DAYS=365
# Activity counts corresponding to increasingly strong heatmap colors.
ACTIVITY_HEATMAP_LEVELS=1,3,5
DASHBOARD_REFRESH_INTERVAL_SECONDS=2

# Retrieval Precision & Thresholds
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.55
CONFIDENCE_HIGH_THRESHOLD=0.80
RETRIEVAL_SMALL_MAX=40
RETRIEVAL_MEDIUM_MAX=150
RETRIEVAL_LARGE_MAX=450
RETRIEVAL_K_SMALL=5
RETRIEVAL_K_MEDIUM=8
RETRIEVAL_K_LARGE=15
RETRIEVAL_K_XL=20

# Server Ports & Host Networking
PORT_HOME=8501
PORT_AGENT1=8502
PORT_AGENT2=8503
PORT_AGENT3=8504
PORT_LANDING=4173
MERCHANTOS_HOST=localhost
FRONTEND_BIND_HOST=127.0.0.1
MERCHANTOS_OPEN_BROWSER=1
LAUNCH_READINESS_TIMEOUT=25
LAUNCH_POLL_INTERVAL=0.25
PORT_CHECK_TIMEOUT=0.2
LAUNCH_MONITOR_INTERVAL=1
LAUNCH_SHUTDOWN_TIMEOUT=8
# Optional full public URLs (for reverse proxies or remote deployments).
# MERCHANTOS_HOME_URL=https://merchant.example.com
# MERCHANTOS_AGENT1_URL=https://kyc.example.com
# MERCHANTOS_AGENT2_URL=https://reconcile.example.com
# MERCHANTOS_AGENT3_URL=https://escalate.example.com
# MERCHANTOS_LANDING_URL=https://merchant.example.com

# Workspace & Currency Settings
MERCHANT_WORKSPACE_NAME="Merchant workspace"
MERCHANT_REGION="India"
MERCHANT_CURRENCY="INR"
MERCHANT_CURRENCY_SYMBOL="₹"

# Payment Aggregator Details
PAYMENT_AGGREGATOR_NAME="Razorpay Software Private Limited"
PAYMENT_AGGREGATOR_SHORT="Razorpay"
PAYMENT_AGGREGATOR_GRIEVANCE_EMAIL="grievance.officer@razorpay.com"
PAYMENT_AGGREGATOR_SUPPORT_URL="razorpay.com/support"
PAYMENT_AGGREGATOR_KYC_URL="https://razorpay.com/docs/payments/business-types-kyc-documents/"
# Fill these with verified details for your configured payment aggregator.
PAYMENT_AGGREGATOR_ADDRESS="[PAYMENT AGGREGATOR REGISTERED ADDRESS]"
PAYMENT_AGGREGATOR_CIN="[PAYMENT AGGREGATOR CIN]"
OMBUDSMAN_URL="https://cms.rbi.org.in"
CONSUMER_HELP_URL="consumerhelpline.gov.in"

# Regulatory references. Re-verify these whenever the source material changes.
PA_DIRECTIONS_NAME="RBI (Regulation of Payment Aggregators) Directions, 2025"
PA_DIRECTIONS_REFERENCE="RBI/DPSS/2025-26/141"
PA_DIRECTIONS_URL="https://www.rbi.org.in/Scripts/BS_ViewMasDirections.aspx?id=12896"
PA_DUE_DILIGENCE_REFERENCE="Chapter IV, paragraph 13"
PA_DISPUTE_REFERENCE="paragraph 8"
PA_SETTLEMENT_REFERENCE="Chapter V, paragraph 16, Table 1"
OMBUDSMAN_SCHEME_REFERENCE="Reserve Bank - Integrated Ombudsman Scheme, 2021"
POLICY_LAST_VERIFIED_DATE=2026-09-12

# Dynamic MDR Fee & Tax Rates
MDR_RATE_UPI=0.0
MDR_RATE_CARD=2.0
MDR_RATE_NETBANKING=1.5
MDR_RATE_WALLET=1.5
MDR_RATE_EMI=2.5
MDR_RATE_PAYLATER=2.0
MDR_RATE_DEFAULT=2.0
GST_RATE=18.0
EXPECTED_SETTLEMENT_DAYS=2
# Deprecated compatibility alias used only when EXPECTED_SETTLEMENT_DAYS is absent.
# TAT_CALENDAR_DAYS=2
# business excludes weekends but not region-specific bank holidays; calendar uses elapsed dates.
SETTLEMENT_DAY_MODE=business
SETTLEMENT_WINDOW_LABEL="configured 2-business-day window"
FEE_OVERCHARGE_TOLERANCE=0.05
FEE_DISPUTE_MIN_AMOUNT=10
HEALTH_MISSING_WEIGHT=2.0
HEALTH_MISSING_MAX_PENALTY=40
HEALTH_TAT_WEIGHT=50
HEALTH_TAT_MAX_PENALTY=20
HEALTH_OVERCHARGE_DIVISOR=100
HEALTH_OVERCHARGE_MAX_PENALTY=20
HEALTH_HEALTHY_MIN=90
HEALTH_MINOR_ISSUES_MIN=70
HEALTH_ATTENTION_MIN=50

# Recovery workflow timelines
SUPPORT_DEADLINE_DAYS=5
GRIEVANCE_TRIGGER_DAYS=5
GRIEVANCE_DEADLINE_DAYS=30
OMBUDSMAN_TRIGGER_DAYS=30
OMBUDSMAN_DEADLINE_DAYS=365
LEGAL_TRIGGER_DAYS=90
GRIEVANCE_LETTER_DEADLINE_DAYS=7
SETTLEMENT_RELEASE_REQUEST_DAYS=2
LEGAL_NOTICE_DEADLINE_DAYS=15
HOLD_RECENT_MAX_DAYS=3
HOLD_STANDARD_MAX_DAYS=14
HOLD_URGENT_TRIGGER_DAYS=15
INITIAL_ACK_HOURS=24
FOLLOWUP_ACK_HOURS=48
URGENT_RESOLUTION_BUSINESS_DAYS=3
TRANSACTION_LOOKBACK_DAYS=30
KYC_CUSTOM_ISSUE_MAX_LENGTH=500

# Landing page media and behavior
HERO_VIDEO_URL="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260823_050407_500d0339-ab28-41c1-9688-132a74a3b5aa.mp4"
ABOUT_VIDEO_URL="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260823_063501_2e2c8971-de1e-473a-8611-a0c9ae7ee186.mp4"
VIDEO_RETRY_INTERVAL_MS=1000

# Ingestion and interface tuning
INGEST_SOURCE_ID_MAX_LENGTH=20
TXT_CHUNKS_PER_PAGE=3
SAMPLE_PREVIEW_ROWS=4
MANUAL_AMOUNT_STEP=50
